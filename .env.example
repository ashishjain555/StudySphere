# ====================================================================
# STUDYSPHERE ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================

# Frontend Supabase Credentials (Required for Real Google OAuth & Database)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend Google Gemini AI Service API Key (for Study Tutor & PDF analysis)
AI_API_KEY=your-google-gemini-api-key-here

# Server Port Configuration
PORT=3001
